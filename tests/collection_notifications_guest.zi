// A real portable guest; only the native fixture substitutes OS effects.
#import "kryon/notification"
#import "kryon/notification_schedule"
#import "kryon/app_context"
#import "kryon/app_protocol"
#if #defined(APPS_NOTIFICATION_NODE) {
    #import "apps/node_types"
    #import "apps/node_app"
    host_api :: #system_library "host_api";
    ReadAppUiHost :: () -> AppUiFrame #foreign host_api;
}

Exercise :: (scenario: s32) -> bool {
    tag := "wurm.daily_chest"
    #if #defined(APPS_NOTIFICATION_SHOVEY) {
        tag = "shovey.daily-chest"
    }
    props := NotificationProps.{.title = "Chest", .body = "Ready", .tag = tag, .id = 1}
    if scenario == 0 || scenario == 1 {
        allowed := scenario == 0
        dates: [2]s32 = .[20280229, 20300101]
        return DailyNotificationsSupported() == allowed &&
        ScheduleDailyNotification(props, 19, 0, true, 1793700000000, 127, 20261102) == allowed &&
        ScheduleNotificationAt(props, 2028, 2, 29, 19) == allowed &&
        ScheduleNotificationDates(props, dates[:], 19) == allowed
    }
    if scenario == 2 || scenario == 3 { return NotificationAppOpened(tag, 1) == (scenario == 2) }
    if scenario == 4 { return CancelDailyNotification(tag, 1) }
    return scenario == 5 && CancelDailyNotification("hosted:arcade.shovey:shovey.daily-chest", 1)
}

#if #defined(APPS_NOTIFICATION_NODE) {
    Draw :: (message: AppMessage) -> bool {
        unused ReadAppUiHost()
        return Exercise(message.screen)
    }
}

#program_export
Main :: () -> s32 {
    #if #defined(APPS_NOTIFICATION_NODE) {
        return RunNodeApp(Draw)
    } else {
        if AppMode() == APP_IDENTIFY {
            AppIdentity("notification")
            AppDescribe("Arcade notification fixture", "")
            return APP_PROTOCOL
        }
        if AppMode() == APP_FRAME { return ifx Exercise(cast(s32)AppBounds().width - 100) then 0 else -1 }
        return 0
    }
}
