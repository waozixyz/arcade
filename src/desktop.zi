#import "std/c_string"
#import "std/byte_text_linux"
#import "kryon/Desktop"
#import "kryon/Widgets"
#import "kryon/Frame"
#import "kryon/test_driver"
#import "platform"
#import "catalog"
#import "collection_host"

sdl :: #system_library "SDL2";
SetTitle :: (window: *void, title: *u8) #foreign sdl "SDL_SetWindowTitle";

Draw :: (session: Session) -> bool {
    BeginDesktopFrame()
    KeyboardModifiersSend(session, DesktopModifiers())
    key := DesktopPressedKey()
    for candidate: cast(s32)0..269 {
        if TestDriverKeyPressed(candidate) { key = candidate; break }
    }
    if key == 256 && CollectionBack() { key = 0 }
    KeyboardSend(session, key)
    // Text typed on the keyboard reaches the game's focused field.
    codepoint := DesktopTypedCodepoint()
    while codepoint != 0 {
        unused TypedCodepointSend(session, codepoint)
        codepoint = DesktopTypedCodepoint()
    }
    viewport := DesktopViewport()
    pointer := TestDriverPointer(session, PollPointer())
    TreePointerUpdate(session, pointer)
    TreeSecondaryPointerUpdate(session, PollSecondaryPointer())
    PointerWheelSend(session, pointer.x, pointer.y, TestDriverWheel(DesktopWheelMove()))
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk { return false }
    collection := CollectionFrame(session, viewport, key, DesktopModifiers())
    if !collection {
        TreeCancel(session)
        Report("collection frame returned false\n")
        return false
    }
    frame_status := EndFrame(session)
    if frame_status != FrameStatus.FrameOk {
        Report("end frame failed\n")
        Report(FrameStatusMessage(cast(s32)frame_status))
        Report("\n")
        return false
    }
    unused DesktopCursor(session)
    ok := EndDesktopFrame()
    TestDriverFrame(session)
    CollectionCollect()
    if !ok { Report("end desktop frame failed\n") }
    return ok
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    standalone := false
    #if #defined(SHOVEY_STANDALONE) {
        standalone = true
    }
    product := ifx standalone then "Shovey" else "Arcade"
    if argc == 2 && TextFromCString(argv[1]) == "--list" {
        if standalone {
            shovey_ids: [3]string = .["arcade.shovey", "arcade.shovey-island", "arcade.shovey-editor"]
            for game: shovey_ids { Report(game); Report("\n") }
            return 0
        }
        for index: cast(s32)0..GameCount - 1 {
            Report(GameAt(index).id)
            Report("\n")
        }
        return 0
    }
    first: s32 = -1
    if argc != 1 {
        if argc != 3 || TextFromCString(argv[1]) != "--app" {
            Report(ifx standalone then "Usage: shovey [--list | --app GAME]\n" else "Usage: arcade [--list | --app GAME]\n")
            return 1
        }
        for index: cast(s32)0..GameCount - 1 {
            game := GameAt(index)
            if TextFromCString(argv[2]) == game.name || TextFromCString(argv[2]) == game.id {
                first = index
            }
        }
        standalone_game := false
        if standalone && first >= 0 {
            shovey_names: [3]string = .["shovey", "shovey-island", "shovey-editor"]
            for game: shovey_names {
                if GameAt(first).name == game { standalone_game = true }
            }
        }
        if first < 0 || (standalone && !standalone_game) {
            Report(product)
            Report(": unknown game\n")
            return 1
        }
    }
    directory := ExecutableDirectory()
    data := DataDirectory()
    if data == "" {
        Report(product)
        Report(": no private data directory\n")
        return 1
    }
    opened := false
    if standalone {
        // Standalone Shovey opens on the game's title screen.
        opened = CollectionOpenShovey(directory, data) &&
        CollectionOpenGame(ifx first < 0 then "arcade.shovey" else GameAt(first).id)
    } else {
        opened = CollectionOpenFiles(directory, data) &&
        (first < 0 || CollectionOpenGame(GameAt(first).id))
    }
    if !opened {
        Report(product)
        Report(": could not open collection or game\n")
        unused CollectionClose()
        return 1
    }
    if !OpenDesktopSized(480, 820) || !WindowInterceptCloseHost(true) {
        unused CollectionClose()
        CloseDesktop()
        return 1
    }
    title: [16]u8
    unused CopyCString(ifx standalone then "Shovey" else "Arcade", title[:])
    SetTitle(window, *title[0])
    session := SessionOpen()
    if !SessionValid(session) {
        unused CollectionClose()
        CloseDesktop()
        return 1
    }
    ok := true
    if CaptureRequested() {
        ok = Draw(session) && Draw(session) && CaptureConfigured()
    } else {
        while ok && PollDesktop() {
            ok = Draw(session)
            if WindowTakeCloseRequestHost() { break }
            if ok { PauseDesktop() }
        }
    }
    if !CollectionClose() { ok = false }
    SessionClose(session)
    CloseDesktop()
    return ifx ok then 0 else 1
}
