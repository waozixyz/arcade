#import "std/c_string"
#import "std/byte_text_linux"
#import "std/timer_linux"
#import "kryon/Desktop"
#import "kryon/Widgets"
#import "kryon/Frame"
#import "kryon/test_driver"
#import "kryon/ScrollDevice"
#import "platform"
#import "catalog"
#import "collection_host"
#import "entity_host"
#import "entity/model"
#import "kryon/carousel"
#import "apps/appearance"
#import "kryon/widget_palette"

sdl :: #system_library "SDL2";
SetTitle :: (window: *void, title: *u8) #foreign sdl "SDL_SetWindowTitle";

DrawStartup :: (session: Session, directory: string, standalone: bool = true) -> bool {
    if !PollDesktop() || WindowTakeCloseRequestHost() { return false }
    BeginDesktopFrame()
    viewport := DesktopViewport()
    art := Join(directory, ifx viewport.height > viewport.width then
        "startup/shovey/title-portrait.png" else "startup/shovey/title-landscape.png")
    logo := Join(directory, "startup/shovey/logo.png")
    defer { EntityFree(art); EntityFree(logo) }
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk { return false }
    if standalone {
        unused CarouselArtwork(session, viewport, cast(u64)48000, art, logo, "Shovey")
    } else {
        unused WidgetPaletteUse(session, AppCoversPalette())
        Box(session, BoxProps.{.key = cast(u64)48000, .bounds = viewport, .fill = Color.{17, 18, 35, 255}})
        Text(session, TextProps.{.key = cast(u64)48001, .text = "Arcade", .font = 32,
                .bounds = Rectangle.{20.0, 20.0, viewport.width - 40.0, 44.0}})
        unused WidgetPaletteRestore(session)
    }
    if EndFrame(session) != FrameStatus.FrameOk { return false }
    ok := EndDesktopFrame()
    TestDriverFrame(session)
    return ok
}

Draw :: (session: Session) -> bool {
    BeginDesktopFrame()
    KeyboardModifiersSend(session, DesktopModifiers())
    key := DesktopPressedKey()
    for candidate: cast(s32)0..269 {
        if TestDriverKeyPressed(candidate) { key = candidate; break }
    }
    if key == 256 && CollectionBack() { key = 0 }
    KeyboardSend(session, key)
    // Text typed on the keyboard reaches the game's focused field.
    codepoint := DesktopTypedCodepoint()
    while codepoint != 0 {
        unused TypedCodepointSend(session, codepoint)
        codepoint = DesktopTypedCodepoint()
    }
    viewport := DesktopViewport()
    pointer := TestDriverPointer(session, PollPointer())
    TreePointerUpdate(session, pointer)
    TreeSecondaryPointerUpdate(session, PollSecondaryPointer())
    wheel := TestDriverWheel(DesktopWheelMove())
    PointerWheelSend(session, pointer.x, pointer.y, wheel)
    BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed,
        pointer.down, pointer.released, wheel,
        cast(float64)MonotonicMilliseconds() / 1000.0)
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk { return false }
    collection := CollectionFrame(session, viewport, key, DesktopModifiers())
    if !collection {
        TreeCancel(session)
        Report("collection frame returned false\n")
        return false
    }
    frame_status := EndFrame(session)
    if frame_status != FrameStatus.FrameOk {
        Report("end frame failed\n")
        Report(FrameStatusMessage(cast(s32)frame_status))
        Report("\n")
        return false
    }
    unused DesktopCursor(session)
    ok := EndDesktopFrame()
    TestDriverFrame(session)
    CollectionCollect()
    if !ok { Report("end desktop frame failed\n") }
    return ok
}

// Standalone Shovey offers only the apps Shovey's package declares.
GameAvailable :: (game: Game) -> bool {
    #if #defined(SHOVEY_STANDALONE) {
        return game.enabled && game.package == "shovey"
    } else {
        return game.enabled
    }
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    standalone := false
    #if #defined(SHOVEY_STANDALONE) {
        standalone = true
    }
    product := ifx standalone then "Shovey" else "Arcade"
    if argc == 2 && TextFromCString(argv[1]) == "--list" {
        for index: cast(s32)0..GameCount - 1 {
            if !GameAvailable(GameAt(index)) { continue }
            Report(GameAt(index).id)
            Report("\n")
        }
        return 0
    }
    first: s32 = -1
    if argc != 1 {
        if argc != 3 || TextFromCString(argv[1]) != "--app" {
            Report(ifx standalone then "Usage: shovey [--list | --app GAME]\n" else "Usage: arcade [--list | --app GAME]\n")
            return 1
        }
        for index: cast(s32)0..GameCount - 1 {
            game := GameAt(index)
            if GameAvailable(game) && (TextFromCString(argv[2]) == game.name || TextFromCString(argv[2]) == game.id) {
                first = index
            }
        }
        if first < 0 {
            Report(product)
            Report(": unknown game\n")
            return 1
        }
    }
    directory := ExecutableDirectory()
    data := DataDirectory()
    if data == "" {
        Report(product)
        Report(": no private data directory\n")
        return 1
    }
    if !OpenDesktopSized(ifx standalone then 480 else 1000, 820) || !WindowInterceptCloseHost(true) {
        CloseDesktop()
        return 1
    }
    defer { CloseDesktop() }
    title: [16]u8
    unused CopyCString(product, title[:])
    SetTitle(window, *title[0])
    session := SessionOpen()
    if !SessionValid(session) { return 1 }
    defer { SessionClose(session) }
    if !DrawStartup(session, directory, standalone) { return 0 }
    // Both open on their library's covers, or straight into a named game.
    opened := ifx standalone then CollectionOpenShovey(directory, data) else CollectionOpenFiles(directory, data)
    if opened && standalone && !DrawStartup(session, directory) { unused CollectionClose(); return 0 }
    opened = opened && (first < 0 || CollectionOpenGame(GameAt(first).id))
    if !opened {
        Report(product)
        Report(": could not open collection or game\n")
        unused CollectionClose()
        return 1
    }
    if standalone && !DrawStartup(session, directory) { unused CollectionClose(); return 0 }
    if !EntityOpenFile(directory, data, standalone) {
        Report("Could not open Entity\n")
        unused CollectionClose()
        return 1
    }
    ok := true
    if CaptureRequested() {
        ok = Draw(session) && Draw(session) && CaptureConfigured()
    } else {
        while ok && PollDesktop() {
            ok = Draw(session)
            if WindowTakeCloseRequestHost() { break }
            if ok { PauseDesktop() }
        }
    }
    if !CollectionClose() { ok = false }
    return ifx ok then 0 else 1
}
