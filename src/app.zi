// Android: Kryon's canonical host (kryon/android_run) draws this Frame. The
// collection comes from the APK's assets; saves and game resources live in
// the app's private files folder.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/tree_input"
#import "kryon/app_asset"
#import "kryon/ScrollDevice"
#import "kryon/raylib_runtime"
#import "std/timer_linux"
#import "collection_host"
#import "entity_host"
#import "platform"

// Android's Back key as raylib reports it.
ARCADE_BACK_KEY :: 4

// 0 until the first frame opens the collection, then 1, or 2 when it failed.
arcade_state: s32;

ArcadeStart :: () -> bool {
    // Later animation pictures load asynchronously too. Keep the last
    // complete frame visible while a new sprite is being decoded.
    RaylibCompletePictureFrames(true)
    // Android before 10 cannot name its system font; the APK carries the
    // same font as the Windows build, so text never falls back to raylib's
    // bitmap font.
    #if #defined(ANDROID_BUILD) {
        if !SelectTypeface("ui") && LoadTypefaceFile("default", "kryon-font.ttf", null, 0) {
            unused SelectTypeface("default")
        }
    }
    data := DataDirectory()
    bundle := ReadAppAsset("arcade.zx")
    metadata := ReadAppAsset("arcade.json")
    defer { FreeAppAsset(bundle); FreeAppAsset(metadata) }
    if data == "" || bundle.count == 0 || metadata.count == 0 {
        Report("Arcade: the collection is missing from the app")
        return false
    }
    opened := false
    #if #defined(SHOVEY_STANDALONE) {
        // Standalone Shovey opens on its covers, as Arcade opens on its library.
        opened = CollectionOpenShoveyBytes(bundle, metadata, data)
    } else {
        // The reviewed shared Apps controller is a host asset, like Entity.
        collection_controller = ReadAppAsset("apps.zx")
        opened = CollectionOpenBytes(bundle, metadata, data)
    }
    if !opened {
        Report("Arcade: could not open the collection")
        return false
    }
    entity := ReadAppAsset("entity.zx")
    defer { FreeAppAsset(entity) }
    #if #defined(SHOVEY_STANDALONE) {
        return entity.count > 0 && EntityOpen(entity, data, true)
    } else {
        return entity.count > 0 && EntityOpen(entity, data)
    }
}

Frame :: (session: Session, viewport: Rectangle) -> s32 {
    if arcade_state == 0 { arcade_state = ifx ArcadeStart() then 1 else 2 }
    if arcade_state != 1 { return 1 }
    #if #defined(ANDROID_BUILD) {
        // Drags scroll the host's own pages, such as the profile, as the
        // desktop and Windows hosts already do.
        pointer := PointerSample(session)
        BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed, pointer.down,
            pointer.released, 0.0, cast(float64)MonotonicMilliseconds() / 1000.0)
    }
    // Back leaves a game for its library. At the library it stays unused,
    // so the host closes the app as Android users expect.
    key := KeyboardTake(session)
    if key == ARCADE_BACK_KEY && CollectionBack() { key = 0 }
    unused KeyboardSend(session, key)
    if !CollectionFrame(session, viewport, key, 0) { return 1 }
    CollectionCollect()
    return 0
}
