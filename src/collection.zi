// Arcade owns its catalog and games. The verified shared apps.zx controller
// supplies the library; the native host owns child navigation and storage.
#import "kryon/app_context"
#import "kryon/app_protocol"

#program_export
Main :: () -> s32 {
    if AppMode() == APP_IDENTIFY {
        AppIdentity("arcade")
        AppDescribe("Arcade", "")
        return APP_PROTOCOL
    }
    return 0
}
