// Generated from games.json and the owning packages' game catalogs.
Game :: struct {
    id: string
    name: string
    title: string
    bundle: string
    preview: string
    enabled: bool
}

GameCount :: 4

GameAt :: (index: s32) -> Game {
    if index == 0 { return Game.{.id = "inbe.chess", .name = "chess", .title = "Chess", .bundle = "chess.zib", .preview = "chess-preview.png", .enabled = false} }
    if index == 1 { return Game.{.id = "arcade.shovey", .name = "shovey", .title = "Shovey", .bundle = "shovey.zib", .preview = "shovey-preview.png", .enabled = true} }
    if index == 2 { return Game.{.id = "arcade.shovey-island", .name = "shovey-island", .title = "Shovey Island", .bundle = "shovey-island.zib", .preview = "shovey-island-preview.png", .enabled = false} }
    if index == 3 { return Game.{.id = "arcade.shovey-editor", .name = "shovey-editor", .title = "Shovey Editor", .bundle = "shovey-editor.zib", .preview = "shovey-editor-preview.png", .enabled = true} }
    return Game.{}
}
