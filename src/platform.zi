#import "std/c_string"
#import "std/byte_text_linux"
#import "std/vec"

libc :: #system_library "libc";
GetEnvironment :: (key: *u8) -> *u8 #foreign libc "getenv";
ReadLink :: (name: *u8, output: *u8, limit: usize) -> isize #foreign libc "readlink";
ChangeDirectory :: (path: *u8) -> s32 #foreign libc "chdir";
WriteError :: (fd: s32, bytes: *u8, count: usize) -> isize #foreign libc "write";

EnvironmentText :: (key: string) -> string {
    name: [64]u8
    if !CopyCString(key, name[:]) { return "" }
    value := GetEnvironment(*name[0])
    return ifx value == null then "" else TextFromCString(value)
}

Join :: (left: string, right: string) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/%", left, right)
    return BuilderFinish(path)
}

ExecutableDirectory :: () -> string {
    name: [32]u8
    path: [4096]u8
    unused CopyCString("/proc/self/exe", name[:])
    length := ReadLink(*name[0], *path[0], cast(usize)4095)
    if length <= 0 || length >= 4095 { return "" }
    at := cast(s64)length - 1
    while at > 0 && path[at] != cast(u8)47 { at -= 1 }
    result: Vec(u8)
    BuilderPrint(*result, "%", TextFromBytes(path[:at]))
    return BuilderFinish(result)
}

DataDirectory :: () -> string {
    exact := EnvironmentText("ARCADE_DATA")
    if exact != "" { return exact }
    base := EnvironmentText("XDG_DATA_HOME")
    if base == "" {
        home := EnvironmentText("HOME")
        if home == "" { return "" }
        base = Join(home, ".local/share")
    }
    return Join(base, "arcade")
}

EnterDirectory :: (path: string) -> bool {
    bytes: [4096]u8
    return CopyCString(path, bytes[:]) && ChangeDirectory(*bytes[0]) == 0
}

Report :: (message: string) {
    bytes: [1024]u8
    if CopyCString(message, bytes[:]) {
        unused WriteError(2, *bytes[0], cast(usize)message.count)
    }
}
