// The game standard every Arcade game implements (standards/game-v1.json).
// GAME_HOST_API is the newest host interface Arcade's players run; a game
// that declares a newer one is refused. scripts/check-games.py fails while it
// differs from the standard and the ledger.
GAME_CONTRACT_VERSION :: 1
GAME_OLDEST_HOST_API :: 41
GAME_HOST_API :: 42
// The older direct loader has no verified reminder dispatch. Products use
// CollectionHost; do not advertise its API42 authority from the direct loader.
GAME_DIRECT_HOST_API :: 41
